# ==========================================
# Configuración de Base de Datos (Knossos)
# ==========================================
# Host o IP de tu mini servidor knossos (ej: knossos.local o 192.168.1.150)
DB_HOST=knossos.local
DB_PORT=5433
DB_NAME=eduscan_db
DB_USER=eduscan_user
DB_PASSWORD=cambia_esta_contrasena_por_una_segura

# ==========================================
# Configuración de la Aplicación Web Local
# ==========================================
APP_ENV=development
APP_PORT=8000
